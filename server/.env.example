# ── Server ────────────────────────────────────────────────
PORT=4000
# Comma-separated list of allowed browser origins. Use * to allow any origin
# (handy for testing from a phone on your LAN; avoid in public deployments).
CLIENT_ORIGIN=http://localhost:3000

# ── Storage ───────────────────────────────────────────────
# Leave empty to use the zero-setup JSON-file store (server/data/db.json).
# Set to use MongoDB (e.g. `docker compose up -d` in the repo root):
# MONGODB_URI=mongodb://localhost:27017/ai-workspace
MONGODB_URI=

# ── LLM providers (all optional; the built-in demo model needs none) ──
# Free real model, no key required (GPT-OSS 20B via Pollinations).
# An optional key raises rate limits: https://auth.pollinations.ai
POLLINATIONS_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Local models via Ollama (models are auto-discovered from /api/tags)
OLLAMA_BASE_URL=http://localhost:11434


# ── Live web search (keyless, DuckDuckGo) ─────────────────
# Answers use current information automatically; sources stay internal.
WEB_SEARCH=on
# WEB_SEARCH_RESULTS=5
# WEB_SEARCH_TIMEOUT_MS=8000
# WEB_SEARCH_ENDPOINT=https://html.duckduckgo.com/html/

# Add or override models shown in the picker (JSON array)
# EXTRA_MODELS=[{"id":"openrouter:mistralai/mistral-large","label":"Mistral Large","contextWindow":128000}]

# ── Limits ────────────────────────────────────────────────
MAX_FILE_MB=10
# Context budget per request, and tokens reserved for the reply.
DEFAULT_CONTEXT_TOKENS=32000
REPLY_RESERVE_TOKENS=4096
